# Скопируйте в .env и задайте свои значения: cp .env.example .env

# Basic-аутентификация. В production (npm start) обязательна:
# без этих переменных сервер не запустится. В dev-режиме без них API открыт.
AUTH_USER="admin"
AUTH_PASSWORD="change-me"

# Порт локального сервера (меняйте при конфликте портов)
PORT=3000
