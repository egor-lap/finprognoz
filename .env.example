# Скопируйте в .env и задайте свои значения: cp .env.example .env

# Basic-аутентификация. В production (NODE_ENV=production, Docker) обязательна:
# без этих переменных сервер не запустится. В dev-режиме без них API открыт.
AUTH_USER="admin"
AUTH_PASSWORD="change-me"

# Порт сервера внутри процесса/контейнера
PORT=3000

# Порт на хосте для docker compose (меняйте при конфликте портов)
HOST_PORT=3000
